# Copy to .env.local for `npm run dev`. Demo values for the local compose stack.

# Auth.js (next-auth v5). Generate a secret: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
AUTH_SECRET=change-me

# Keycloak OIDC — employee-portal is a public client (PKCE, no secret)
KEYCLOAK_CLIENT_ID=employee-portal
KEYCLOAK_ISSUER=http://localhost:8080/realms/corporate-travel

# Server-side only: Keycloak admin API for the admin stats route
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_REALM=corporate-travel
