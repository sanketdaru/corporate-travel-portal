# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=corporate_travel

# Neo4j Configuration
NEO4J_AUTH=neo4j/password123

# Keycloak Configuration
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin123

# Realm-as-code (keycloak-config service) — substituted into infrastructure/keycloak/config/*.json
# Demo user password is set on user creation only; changing it later does not reset existing users.
KC_DEMO_USER_PASSWORD=password123
KC_CLIENT_SECRET_CONSENT_SERVICE=consent-service-secret-change-in-production
KC_CLIENT_SECRET_DELEGATION_SERVICE=delegation-service-secret-change-in-production
# Must match keycloak.client-secret in services/employee-bff application.yml
KC_CLIENT_SECRET_EMPLOYEE_BFF=bff-service-secret-change-in-production
KC_CLIENT_SECRET_EXPENSE_SERVICE=expense-service-secret-change-in-production
KC_CLIENT_SECRET_TRAVEL_SERVICE=travel-service-secret-change-in-production
KC_CLIENT_SECRET_DELEGATION_GRANT=delegation-grant-secret-change-in-production

# Delegation grant store (ADR-024): AES-256-GCM key (base64, 32 bytes) for delegators' offline
# tokens at rest. Generate your own: openssl rand -base64 32
BFF_GRANT_ENCRYPTION_KEY=K9I0s1jbgA7DM/sfcm7bhvgAwpn2w90k61O85nvfyvQ=

# Application Configuration
SPRING_PROFILES_ACTIVE=docker

# API gateway: comma-separated browser origins allowed by CORS
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Frontend: see frontend/nextjs/.env.example
